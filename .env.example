# Dribbble OAuth Configuration
# Create an app at: https://dribbble.com/account/applications
DRIBBBLE_CLIENT_ID=your_dribbble_client_id
DRIBBBLE_CLIENT_SECRET=your_dribbble_client_secret

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl_rand_base64_32

# Note: Generate NEXTAUTH_SECRET with: openssl rand -base64 32
